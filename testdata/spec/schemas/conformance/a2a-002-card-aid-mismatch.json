{
  "id": "a2a-002",
  "rfc": "RFC-AITP-0014",
  "status": "draft",
  "required_for_v0_1": false,
  "required_for_core": false,
  "feature": "aitp-a2a-agent-card",
  "$comment": "The Agent Card is an A2A 1.0.0 AgentCard (JSON names as in the A2A specification, https://a2a-protocol.org/latest/specification/). `input.agent_card` is the Card as fetched; `input.selected_interface_url` is the AgentInterface the client intends to call; `input.manifest` is the Manifest fetched from the Card's `params.manifestUrl` (inner body; placeholders resolve as for man-*), or `input.manifest_fetch` records a fetch outcome. The runner MUST NOT fetch anything. Agent C's AID is kat-keypair-003; the Manifest is kat-keypair-002's.",
  "description": "The Agent Card's `params.aid` names agent C, but the Manifest at `params.manifestUrl` is agent B's and verifies as agent B's. RFC-AITP-0014 §4.2 step 4: the Manifest's AID MUST denote the same key as the Card's AID. It does not, so the binding fails with IDENTITY_FAILED and the client contacts nobody.",
  "tags": [
    "failure",
    "a2a",
    "agent-card",
    "aid-mismatch"
  ],
  "input": {
    "self_aid": "aid:pubkey:O2onvM62pC1io6jQKm8Nc2UyFXcd4kOmOsBIoYtZ2ik",
    "now": 1711900100,
